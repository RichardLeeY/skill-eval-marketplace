  "annotations": [
    {
      "n": 1,
      "target": "cf",
      "text": "<b>Amazon CloudFront</b> terminates TLS at the edge and absorbs cacheable traffic before it reaches the origin. <b>AWS WAF</b> can be attached here rather than at the load balancer, which stops malicious requests before they consume origin capacity."
    },
    {
      "n": 2,
      "target": "alb",
      "text": "The load balancer is the only component in a public subnet. Everything that holds application state or data sits in private subnets with no route to the internet gateway."
    },
    {
      "n": 3,
      "target": "ecs1",
      "text": "<b>AWS Fargate</b> is used so there are no instances to patch. The same task definition runs on <b>Amazon EC2</b> capacity instead where a workload needs GPUs or a longer-lived host."
    },
    {
      "n": 4,
      "target": "az2",
      "text": "Two Availability Zones are drawn, but the architecture extends to three without change. Zone count is a cost and quorum decision, not a structural one."
    },
    {
      "n": 5,
      "target": "rds_standby",
      "text": "The standby is a Multi-AZ replica promoted automatically on failure of the primary; it does not serve reads. Add read replicas where read capacity, rather than availability, is the constraint."
    }
  ]
