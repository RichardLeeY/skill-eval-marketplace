          <mxGeometry x="1159" y="288" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="note-text-2" value="&lt;b&gt;AWS Lambda&lt;/b&gt; concurrency follows upload rate, so no capacity is provisioned for peaks. The handler must be idempotent: &lt;b&gt;Amazon S3&lt;/b&gt; notification delivery is at-least-once, and a retried invocation will see the same object key twice." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
