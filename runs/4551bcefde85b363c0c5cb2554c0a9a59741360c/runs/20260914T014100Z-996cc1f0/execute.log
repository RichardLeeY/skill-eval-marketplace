        </mxCell>
        <mxCell id="note-text-3" value="Invocations that exhaust their retries go to an &lt;b&gt;Amazon SQS&lt;/b&gt; dead-letter queue rather than being dropped, which keeps a poison object from silently disappearing from the pipeline." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
