```xml
<mxfile host="app.diagrams.net" type="device">
  <diagram id="aws-diagram" name="Event-Driven Object Processing on AWS">
    <mxGraphModel dx="900" dy="640" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1574" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="doc-title" value="Event-Driven Object Processing on AWS" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=30;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="26" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="doc-subtitle" value="S3 event notifications, Lambda processing, DynamoDB metadata" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=19;fontStyle=0;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="66" width="1100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="doc-intent" value="Object uploads drive the pipeline directly through Amazon S3 event notifications, so no component polls for work and capacity scales with the arrival rate rather than with a provisioned fleet." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=13;fontStyle=0;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="98" width="1000" height="22" as="geometry" />
        </mxCell>
        <mxCell id="doc-panel" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#D5DBDB;verticalAlign=top;align=left;" vertex="1" parent="1">
          <mxGeometry x="1204" y="160" width="330" height="920" as="geometry" />
        </mxCell>
        <mxCell id="note-badge-1" value="1" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#146EB4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="176" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="note-text-1" value="The landing bucket is the only entry point; clients get pre-signed URLs rather than a compute front door, so there is no API tier to scale or defend. Writes are the trigger, which is why the derived output goes to a &lt;b&gt;second&lt;/b&gt; bucket — emitting results into the source bucket would re-trigger the same notification and loop." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1256" y="176" width="262" height="111" as="geometry" />
        </mxCell>
        <mxCell id="note-badge-2" value="2" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#146EB4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="303" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="note-text-2" value="&lt;b&gt;Amazon EventBridge&lt;/b&gt; sits between the bucket and the function so more than one consumer can subscribe to the same upload later without editing the bucket. Where exactly one consumer is certain, a direct &lt;b&gt;Amazon S3&lt;/b&gt; notification to &lt;b&gt;AWS Lambda&lt;/b&gt; removes this hop and its cost." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1256" y="303" width="262" height="96" as="geometry" />
        </mxCell>
        <mxCell id="note-badge-3" value="3" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#146EB4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="415" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="note-text-3" value="&lt;b&gt;AWS Lambda&lt;/b&gt; runs outside a VPC here because it reaches only &lt;b&gt;Amazon DynamoDB&lt;/b&gt; and &lt;b&gt;Amazon S3&lt;/b&gt; over their public endpoints with &lt;b&gt;AWS Identity and Access Management (IAM)&lt;/b&gt; authorisation. Attach it to private subnets with gateway endpoints only when it must reach a VPC-bound resource such as &lt;b&gt;Amazon RDS&lt;/b&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1256" y="415" width="262" height="111" as="geometry" />
        </mxCell>
        <mxCell id="note-badge-4" value="4" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#146EB4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="542" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="note-text-4" value="Retries are automatic and idempotency is the function&apos;s responsibility: the same object can be delivered more than once. Events that exhaust retries land in the dead-letter queue instead of being dropped, which makes poison objects a queue depth alarm rather than silent data loss." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1256" y="542" width="262" height="111" as="geometry" />
        </mxCell>
        <mxCell id="note-badge-5" value="5" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#146EB4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="669" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="note-text-5" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt; holds metadata keyed by object key, sized on-demand so it tracks the same bursty arrival pattern as the function. Bulk content stays in &lt;b&gt;Amazon S3&lt;/b&gt;; the table is deliberately an index, not a document store." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1256" y="669" width="262" height="81" as="geometry" />
        </mxCell>
        <mxCell id="note-badge-6" value="6" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#146EB4;strokeColor=#FFFFFF;strokeWidth=2;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1220" y="766" width="26" height="26" as="geometry" />
        </mxCell>
        <mxCell id="note-text-6" value="This view shows the synchronous processing path only. Reprocessing history, lifecycle transitions to &lt;b&gt;Amazon S3 Glacier&lt;/b&gt;, and downstream analytics over the derived bucket are out of scope and drawn separately." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="1256" y="766" width="262" height="81" as="geometry" />
        </mxCell>
